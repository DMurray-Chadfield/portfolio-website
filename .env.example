# Example environment file for running the application in production.
#
# Copy this file and fill in real values:
#
#   cp .env.example .env
#
# `.env` is git-ignored, so real secrets are never committed. Keep this
# example file free of real credentials.
#
# Usage:
#   ./run_docker.sh .env
#   ./create_db.sh .env
#   docker run --network host -d --env-file .env --name portfolio-website <image>

# Selects the configuration file to load (app-production.conf).
# Defaults to `local` when unset, so it must be set for production runs.
KOTLINBOOK_ENV=production

# Port the HTTP server listens on.
KOTLINBOOK_HTTP_PORT=4207

# PostgreSQL connection. The database name is parsed from the URL by create_db.sh.
# `localhost` is correct even when the app runs in Docker: the container is started
# with --network host, so it shares the host's network namespace and reaches the
# host's PostgreSQL directly (no published ports needed).
KOTLINBOOK_DB_URL=jdbc:postgresql://localhost:5432/portfolio_website
KOTLINBOOK_DB_USER=portfolio_website
KOTLINBOOK_DB_PASSWORD=change-me

# Session cookie and remember-me secrets. These are hex-encoded and must be
# unique per environment. Generate each one with the commands below and paste
# the output here:
#
#   openssl rand -hex 16   # KOTLINBOOK_COOKIE_ENCRYPTION_KEY (16 bytes / 32 hex chars)
#   openssl rand -hex 32   # KOTLINBOOK_COOKIE_SIGNING_KEY    (32 bytes / 64 hex chars)
#   openssl rand -hex 32   # KOTLINBOOK_REMEMBER_ME_KEY       (32 bytes / 64 hex chars)
KOTLINBOOK_COOKIE_ENCRYPTION_KEY=replace-with-32-hex-characters
KOTLINBOOK_COOKIE_SIGNING_KEY=replace-with-64-hex-characters
KOTLINBOOK_REMEMBER_ME_KEY=replace-with-64-hex-characters
